# Copy to .env on the server and restrict it to the deployment user (chmod 600).
# Use new preview-only database credentials and a new NEXTAUTH_SECRET.
POSTGRES_USER=splitpro_preview
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=splitpro_preview
DATABASE_URL=postgresql://splitpro_preview:replace-with-a-long-random-password@postgres:5432/splitpro_preview

NEXTAUTH_SECRET=replace-with-a-new-random-secret
NEXTAUTH_URL=https://prodesk.tail960ba6.ts.net/splitprointegration/api/auth
NEXTAUTH_URL_INTERNAL=http://splitpro-preview-app:3000/splitprointegration/api/auth
NEXT_PUBLIC_APP_BASE_PATH=/splitprointegration

# Reuse the production Google OAuth client credentials. Add the preview callback
# URL to that client's authorized redirect URIs without removing the root URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_AUTO_REDIRECT=true

# Do not allow the preview copy to send messages or run copied bank/push integrations.
ENABLE_SENDING_INVITES=false
DISABLE_EMAIL_SIGNUP=true
INVITE_ONLY=true
DISABLE_PUSH_NOTIFICATIONS=true
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
FROM_EMAIL=
FEEDBACK_EMAIL=
DISCORD_WEBHOOK_URL=
WEB_PUSH_EMAIL=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_PUBLIC_KEY=
GOCARDLESS_COUNTRY=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_INTERVAL_IN_DAYS=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_COUNTRY_CODES=
PLAID_INTERVAL_IN_DAYS=
CLEAR_CACHE_CRON_RULE=
CACHE_RETENTION_INTERVAL=
